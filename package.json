{
    "name": "global2hand",
    "version": "1.0.0",
    "main": "app.js",
    "scripts": {
        "start": "node app.js",
        "dev": "nodemon app.js",
        "test": "jest --coverage",
        "test:watch": "jest --watch",
        "profile:static": "es6-plato -r -d report-static controllers models routes middlewares app.js"
    },
    "jest": {
        "testEnvironment": "node",
        "testMatch": [
            "**/tests/**/*.test.js"
        ],
        "collectCoverageFrom": [
            "controllers/**/*.js",
            "models/**/*.js",
            "routes/**/*.js",
            "middlewares/**/*.js",
            "app.js"
        ],
        "coverageThreshold": {
            "global": {
                "statements": 40
            }
        },
        "coverageReporters": [
            "text",
            "lcov",
            "html"
        ]
    },
    "dependencies": {
        "body-parser": "^1.20.2",
        "cloudinary": "^2.9.0",
        "dotenv": "^17.3.1",
        "ejs": "^3.1.10",
        "express": "^4.22.1",
        "express-session": "^1.19.0",
        "jest": "^30.3.0",
        "method-override": "^3.0.0",
        "mongodb": "^7.1.1",
        "mongodb-memory-server": "^11.0.1",
        "mongoose": "^9.3.3",
        "multer": "^2.1.1",
        "multer-storage-cloudinary": "^2.2.1",
        "passport": "^0.7.0",
        "passport-google-oauth20": "^2.0.0"
    },
    "devDependencies": {
        "es6-plato": "^1.2.3",
        "supertest": "^7.2.2"
    }
}

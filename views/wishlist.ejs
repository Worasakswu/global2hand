<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <%- include('partials/common-head') %>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Global2Hand - Wishlist</title>
  <link rel="stylesheet" href="/css/wishlist.css" />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@400;500;600&display=swap"
    rel="stylesheet" />
</head>

<body>
  <%- include('partials/header') %>

    <main class="container section-spacing">
      <div class="wishlist-top-header">
        <span class="wishlist-count-text">Wishlist (<%= totalItems %>)</span>
      </div>

      <div class="product-grid">
        <% if (products && products.length> 0) { %>
          <% products.forEach(item=> { %>
            <div class="product-card">
              <div class="product-thumb">
                <form action="/wishlist/remove/<%= item._id %>" method="POST" class="thumb-actions">
                  <button type="submit" class="thumb-action-btn" title="Remove from Wishlist">
                    <img src="/image/bin.png" alt="Remove" style="width: 14px; height: 14px;">
                  </button>
                </form>
                <% const prodImg=(item.images && item.images.length> 0) ? item.images[0] : (item.image ||
                  '/image/electronics.png'); %>
                  <img src="<%= prodImg %>" alt="<%= item.name %>" class="img-main" />
                  <div class="thumb-actions-bottom">
                    <a href="/items/<%= item._id %>" class="view-item-btn">View Detail</a>
                  </div>
              </div>
              <div class="product-info">
                <h4>
                  <%= item.name %>
                </h4>
                <div class="price-row">
                  <span class="new-price">฿<%= item.price.toLocaleString() %></span>
                </div>
              </div>
            </div>
            <% }) %>
              <% } else { %>
                <div style="grid-column: 1/-1; text-align: center; padding: 50px 0; color: #999;">
                  <h3>Your Wishlist is Empty</h3>
                  <p>Go back to the homepage and find something you like!</p>
                  <a href="/" class="btn-outline-action"
                    style="display: inline-block; margin-top: 20px; text-decoration:none; color:#db4444; border:1px solid #db4444; padding:10px 20px;">Back
                    to Home</a>
                </div>
                <% } %>
      </div>

      <!-- Pagination UI -->
      <% if (totalPages > 1) { %>
      <div class="pagination" style="display: flex; justify-content: center; align-items: center; gap: 10px; margin-top: 50px; margin-bottom: 50px;">
        <% 
          const buildUrl = (p) => {
            return `/wishlist?page=${p}`;
          };
        %>
        
        <% if (currentPage > 1) { %>
          <a href="<%= buildUrl(currentPage - 1) %>" style="text-decoration: none; padding: 8px 16px; background: #f5f5f5; border-radius: 4px; color: #333;">&larr; Prev</a>
        <% } %>

        <% for(let i = 1; i <= totalPages; i++) { %>
          <a href="<%= buildUrl(i) %>" 
             style="text-decoration: none; padding: 8px 16px; <%= currentPage === i ? 'background: #db4444; color: #fff;' : 'background: #f5f5f5; color: #333;' %> border-radius: 4px;">
             <%= i %>
          </a>
        <% } %>

        <% if (currentPage < totalPages) { %>
          <a href="<%= buildUrl(currentPage + 1) %>" style="text-decoration: none; padding: 8px 16px; background: #f5f5f5; border-radius: 4px; color: #333;">Next &rarr;</a>
        <% } %>
      </div>
      <% } %>
    </main>
    <%- include('partials/footer') %>
</body>

</html>